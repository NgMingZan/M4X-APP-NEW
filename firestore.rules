rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }
    match /themes/{themeId} {
      allow read: if resource.data.status == 'APPROVED' || isAdmin() || (signedIn() && resource.data.creatorUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.creatorUid == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin() || (signedIn() && resource.data.userUid == request.auth.uid);
    }
    match /notifications/{id} {
      allow read, update: if signedIn() && resource.data.userUid == request.auth.uid;
      allow create, delete: if isAdmin();
    }
    match /reports/{id} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }
    match /appConfig/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
